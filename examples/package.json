{
  "name": "examples",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "format": "biome format --write src/**/*.tsx",
    "lint": "biome lint src/**/*.tsx",
    "fix": "biome check --write --unsafe src/**/*.tsx",
    "preview": "vite preview"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.12.1",
      "onFail": "error"
    }
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
